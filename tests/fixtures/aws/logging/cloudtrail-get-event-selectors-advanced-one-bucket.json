{
  "TrailARN": "arn:aws:cloudtrail:us-east-1:111122223333:trail/acme-notes-trail",
  "AdvancedEventSelectors": [
    {
      "Name": "Management events",
      "FieldSelectors": [
        {
          "Field": "eventCategory",
          "Equals": [
            "Management"
          ]
        }
      ]
    },
    {
      "Name": "Uploads bucket",
      "FieldSelectors": [
        {
          "Field": "eventCategory",
          "Equals": [
            "Data"
          ]
        },
        {
          "Field": "resources.type",
          "Equals": [
            "AWS::S3::Object"
          ]
        },
        {
          "Field": "resources.ARN",
          "StartsWith": [
            "arn:aws:s3:::acme-notes-uploads/"
          ]
        }
      ]
    }
  ]
}
